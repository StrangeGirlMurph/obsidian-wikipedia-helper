{
	"name": "wikipedia-helper",
	"version": "2.7.3",
	"description": "A better Obsidian Wikipedia plugin: Search, link, insert and open Wikipedia/Wikimedia articles directly from the app.",
	"main": "src/main.js",
	"type": "module",
	"scripts": {
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"prettify": "eslint --fix . && npx prettier -w .",
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json src/utils/toolsAPI.ts docs/changelog.md",
		"postversion": "git push && git push --tags",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs"
	},
	"keywords": [],
	"author": "StrangeGirlMurph",
	"license": "SEE LICENSE",
	"devDependencies": {
		"@eslint/js": "^8.57.0",
		"@types/node": "^20.12.12",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"esbuild": "^0.28.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"eslint-plugin-prettier": "^5.1.3",
		"globals": "^17.7.0",
		"obsidian": "latest",
		"prettier": "^3.2.5",
		"tslib": "2.6.2",
		"typescript": "5.4.5",
		"vitepress": "^1.6.4"
	}
}
